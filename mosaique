#!/usr/bin/env bash
# Lance le serveur Mosaïque (s'il ne tourne pas déjà) et ouvre l'interface.
DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
PORT="${MOSAIQUE_PORT:-8765}"
URL="http://127.0.0.1:$PORT/"

if ! curl -s -o /dev/null "$URL"; then
  setsid -f python3 "$DIR/server.py" >/dev/null 2>&1
  for _ in $(seq 30); do curl -s -o /dev/null "$URL" && break; sleep 0.1; done
fi

if command -v omarchy-launch-webapp >/dev/null; then
  omarchy-launch-webapp "$URL" >/dev/null 2>&1 &
else
  xdg-open "$URL" >/dev/null 2>&1 &
fi
